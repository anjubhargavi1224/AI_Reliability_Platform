        "claim_evidence_alignment": {
          "expected_status": "not_assessed",
          "expected_finding_codes": []
        }
      }
    },
    {
      "case_id": "case-grounding-05",
      "category": "grounding",
      "description": "Citation specifically resolves to target source src-target.",
      "prompt": "What latency optimization was achieved?",
