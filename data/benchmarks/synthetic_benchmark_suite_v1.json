{
  "name": "Synthetic Evaluation Benchmark Suite v1",
  "version": "1.0.0",
  "description": "Deterministic multi-category benchmark suite for verifying platform evaluators against standardized synthetic test cases. These synthetic cases are human-authored software test fixtures and do not represent real-world model outputs or ground truth factual knowledge.",
  "dataset_kind": "synthetic",
  "cases": [
    {
      "case_id": "case-grounding-01",
      "category": "grounding",
      "description": "Fully aligned response claim with exact lexical and numeric match in evidence.",
      "prompt": "What was the reported benchmark accuracy for Model A?",
      "response": "Model A achieved 94.5% accuracy on the evaluation dataset.",
      "context": [
        {
          "id": "src-grounding-01",
          "text": "Model A achieved 94.5% accuracy on the evaluation dataset after fine-tuning."
        }
      ],
      "citations": [],
      "expected_annotations": {
        "claim_evidence_alignment": {
          "expected_status": "completed",
          "expected_claim_alignment": "aligned",
          "expected_finding_codes": ["claim_evidence_aligned"]
        },
        "percentage_presence": {
          "expected_status": "completed",
          "expected_finding_codes": []
        }
      }
    },
    {
      "case_id": "case-grounding-02",
      "category": "grounding",
      "description": "Response introduces an unsupported numeric percentage value absent from evidence.",
      "prompt": "What throughput improvement was measured?",
      "response": "The new pipeline increased throughput by 45%.",
      "context": [
        {
          "id": "src-grounding-02",
          "text": "The new pipeline increased throughput by 10% under sustained load."
        }
      ],
      "citations": [],
      "expected_annotations": {
        "percentage_presence": {
          "expected_status": "completed",
          "expected_finding_codes": ["percentage_not_in_context"]
        },
        "claim_evidence_alignment": {
          "expected_status": "completed",
          "expected_claim_alignment": "potentially_contradicted",
          "expected_finding_codes": ["claim_potentially_contradicted"]
        }
      }
    },
    {
      "case_id": "case-grounding-03",
      "category": "grounding",
      "description": "Topic terms overlap strongly but numeric percentage conflicts directly.",
      "prompt": "What was the error reduction rate?",
      "response": "The algorithm achieved an 80% error reduction rate.",
      "context": [
        {
          "id": "src-grounding-03",
          "text": "The algorithm achieved an 20% error reduction rate in the final ablation."
        }
      ],
      "citations": [],
      "expected_annotations": {
        "claim_evidence_alignment": {
          "expected_status": "completed",
          "expected_claim_alignment": "potentially_contradicted",
          "expected_finding_codes": ["claim_potentially_contradicted"]
        }
      }
    },
    {
      "case_id": "case-grounding-04",
      "category": "grounding",
      "description": "Empty context supplied; grounding evaluators must cleanly abstain as not_assessed.",
      "prompt": "What is the capital of France?",
      "response": "Paris is the capital of France.",
      "context": [],
      "citations": [],
      "expected_annotations": {
        "percentage_presence": {
          "expected_status": "not_assessed",
          "expected_finding_codes": []
