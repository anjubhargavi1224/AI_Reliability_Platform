        }
      }
    },
    {
      "case_id": "case-grounding-06",
      "category": "grounding",
      "description": "Citation explicitly references wrong source src-wrong; evidence from src-valid is isolated.",
      "prompt": "What latency optimization was achieved?",
      "response": "The latency was reduced to 15ms according to src-wrong.",
      "context": [
        {
          "id": "src-valid",
          "text": "The latency was reduced to 15ms after memory layout optimizations."
        },
        {
          "id": "src-wrong",
          "text": "Database backup jobs run daily at midnight."
        }
      ],
      "citations": [
        {
          "id": "cit-wrong-01",
